# Test the C++17 baseline with bundled dependencies and the portable scalar ISA.
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(LINALG_CXX_STANDARD 17 CACHE STRING "")
set(LOGGING_CXX_STANDARD 17 CACHE STRING "")
set(LINALG_VECTORIZATION_ISA scalar CACHE STRING "")
set(LINALG_ENABLE_TESTING ON CACHE BOOL "")
set(LINALG_ENABLE_GTEST ON CACHE BOOL "")
set(LINALG_ENABLE_CACHE OFF CACHE BOOL "")
set(LOGGING_ENABLE_CACHE OFF CACHE BOOL "")
set(XSIGMA_ENABLE_EXTERNAL OFF CACHE BOOL "")
# magic_enum requires GCC 9+; enum reflection is optional in Logging.
set(LOGGING_ENABLE_MAGICENUM OFF CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_cpuinfo ON CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_Profiler ON CACHE BOOL "")
