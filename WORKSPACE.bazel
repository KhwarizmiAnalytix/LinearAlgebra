# =============================================================================
# LinearAlgebra — Bazel workspace (standalone)
# =============================================================================
# Standalone Bazel build for the LinearAlgebra library. When consumed from
# XSigma, XSigma's own workspace provides an overlay BUILD file instead — do
# not edit this repo's vendored third-party trees.
# =============================================================================

workspace(name = "khwarizmi_linear_algebra")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# =============================================================================
# Bazel Skylib
# =============================================================================
http_archive(
    name = "bazel_skylib",
    urls = [
        "https://mirror.bazel.build/github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz",
        "https://github.com/bazelbuild/bazel-skylib/releases/download/1.4.2/bazel-skylib-1.4.2.tar.gz",
    ],
)

load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")

bazel_skylib_workspace()

# =============================================================================
# Google Test — vendored nested submodule (ThirdParty/)
# =============================================================================
local_repository(
    name = "com_google_googletest",
    path = "ThirdParty/googletest",
)

# =============================================================================
# ThirdParty/Logging's own backend deps — nested submodules under
# ThirdParty/Logging/ThirdParty/, using Logging's own BUILD overlay files.
# Logging's default backend (LOGURU) plus its always-on deps (fmt,
# magic_enum) are wired here; glog/spdlog are omitted since nothing in this
# workspace selects logging_backend=glog|spdlog (see bazel/logging.bzl).
# =============================================================================
new_local_repository(
    name = "fmt",
    build_file = "//ThirdParty/Logging/ThirdParty:fmt.BUILD",
    path = "ThirdParty/Logging/ThirdParty/fmt",
)

new_local_repository(
    name = "magic_enum",
    build_file = "//ThirdParty/Logging/ThirdParty:magic_enum.BUILD",
    path = "ThirdParty/Logging/ThirdParty/magic_enum",
)

new_local_repository(
    name = "loguru",
    build_file = "//ThirdParty/Logging/ThirdParty:loguru.BUILD",
    path = "ThirdParty/Logging/ThirdParty/loguru",
)
