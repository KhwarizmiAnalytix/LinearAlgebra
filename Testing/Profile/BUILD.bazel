load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:linear_algebra.bzl", "linear_algebra_arch_copts", "linear_algebra_copts", "linear_algebra_defines", "linear_algebra_gpu_copts", "linear_algebra_linkopts")

package(default_visibility = ["//visibility:public"])

# Mirrors Testing/Profile/CMakeLists.txt (target names are lowercased from
# the filename, matching Testing/Benchmark/BUILD.bazel's convention, rather
# than CMake's hand-picked profile_linalg_matrix_operations/_eigen names).
# Gated the same way as the CUDA/HIP device libraries in BUILD.bazel:
# incompatible by default so a plain `bazel build //...` never needs
# @linalg_profiler (see bazel/profiler_repository.bzl) or an installed
# Profiler package.
[
    cc_binary(
        name = "profile_linalg_" + _src[len("Profile"):-len(".cxx")].lower(),
        srcs = [_src],
        copts = linear_algebra_copts() + linear_algebra_arch_copts() + linear_algebra_gpu_copts(),
        defines = linear_algebra_defines(),
        includes = ["."],
        linkopts = linear_algebra_linkopts(),
        target_compatible_with = select({
            "//bazel:linalg_enable_profiling": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//:LinearAlgebra",
            "@linalg_profiler//:profiler",
        ],
    )
    for _src in glob(
        ["Profile*.cxx"],
        allow_empty = True,
    )
]
