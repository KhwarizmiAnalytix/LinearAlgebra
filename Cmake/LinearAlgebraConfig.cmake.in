@PACKAGE_INIT@

# LinearAlgebra CMake configuration file
# Enables: find_package(LinearAlgebra CONFIG REQUIRED)

include(CMakeFindDependencyMacro)

# --- Logging (required) ---
# LinearAlgebra links Logging::Logging PUBLIC (every LOGGING_THROW/LOGGING_CHECK
# call site in include/matrix_operation* throws logging::exception), so
# Logging::Logging is part of LinearAlgebraTargets.cmake's link interface and
# must resolve wherever LinearAlgebra is consumed. LinearAlgebra's own build
# embeds Logging via add_subdirectory(ThirdParty/Logging EXCLUDE_FROM_ALL),
# which does not run Logging's own install() rules, so a consumer of this
# installed package must make Logging discoverable separately (e.g. build
# and install KhwarizmiAnalytix/Logging to a prefix on CMAKE_PREFIX_PATH).
find_dependency(Logging)

# --- Optional Intel MKL backend (LINALG_ENABLE_MKL) ---
# Only part of this package's link interface when the installed LinearAlgebra
# was itself configured with LINALG_ENABLE_MKL=ON.
set(LinearAlgebra_HAS_MKL @LINALG_ENABLE_MKL@)
if(LinearAlgebra_HAS_MKL)
    set(MKL_INTERFACE "ilp64")
    find_dependency(MKL CONFIG)
    if(NOT TARGET MKL::MKL)
        set(LinearAlgebra_NOT_FOUND_MESSAGE "Intel oneMKL must provide MKL::MKL (ILP64)")
        set(LinearAlgebra_FOUND FALSE)
        return()
    endif()
endif()

# --- Optional vendor-neutral BLAS/LAPACK backend (LINALG_ENABLE_BLAS) ---
set(LinearAlgebra_HAS_BLAS @LINALG_ENABLE_BLAS@)
# Combined builds load the independent BLAS provider privately at runtime.
# Rediscovering BLAS here could add MKL's LP64 interface to a consumer's link.
if(LinearAlgebra_HAS_BLAS AND NOT LinearAlgebra_HAS_MKL)
    set(BLA_VENDOR "@LINALG_BLAS_VENDOR@")
    set(BLA_SIZEOF_INTEGER 4)
    set(_linalg_blis_config "@_linalg_blis_found_via_config@")
    if(_linalg_blis_config)
        find_dependency(BLIS CONFIG)
    else()
        find_dependency(BLAS)
    endif()
    if(NOT "@LINALG_ENABLE_BLIS@")
        find_dependency(LAPACK)
    endif()
endif()

# --- Optional cuBLAS/cuSOLVER GPU backend (LINALG_ENABLE_CUBLAS) ---
set(LinearAlgebra_HAS_CUBLAS @LINALG_ENABLE_CUBLAS@)
if(LinearAlgebra_HAS_CUBLAS)
    find_dependency(CUDAToolkit)
endif()

# --- Optional hipBLAS/hipSOLVER GPU backend (LINALG_ENABLE_ROCBLAS) ---
set(LinearAlgebra_HAS_ROCBLAS @LINALG_ENABLE_ROCBLAS@)
if(LinearAlgebra_HAS_ROCBLAS)
    find_dependency(hip CONFIG)
    find_dependency(hipblas CONFIG)
    find_dependency(hipsolver CONFIG)
endif()

# --- Optional cpuinfo backend, auto-detected (LINALG_HAS_CPUINFO) ---
# Only part of this package's link interface when find_package(cpuinfo)
# succeeded for the installed LinearAlgebra's own build.
set(LinearAlgebra_HAS_CPUINFO @LINALG_HAS_CPUINFO@)
if(LinearAlgebra_HAS_CPUINFO)
    find_dependency(cpuinfo)
endif()

# --- Optional Profiler backend (LINALG_HAS_PROFILER) ---
# Only part of this package's link interface when LINALG_ENABLE_PROFILING
# was enabled for the installed LinearAlgebra's own build.
set(LinearAlgebra_HAS_PROFILER @LINALG_HAS_PROFILER@)
if(LinearAlgebra_HAS_PROFILER)
    find_dependency(Profiler)
endif()

if(NOT TARGET LinearAlgebra::LinearAlgebra)
    include("${CMAKE_CURRENT_LIST_DIR}/LinearAlgebraTargets.cmake")
endif()

check_required_components(LinearAlgebra)
