# lto.cmake — per-target LTO + linker
#
# Defaults (override with -D<PREFIX>_LTO_MODE=… and -D<PREFIX>_LINKER_CHOICE=…):
#   PERFORMANCE + non-Debug  → LTO_MODE auto (Clang GNU driver: ThinLTO; GCC/MSVC: IPO)
#   SUPPORT or Debug         → LTO off
#   Linker default           → best available: LTO on prefers lld→mold→gold (Clang); off prefers mold→gold→lld
#
# Modes: off | thin | full | ipo | auto
# Linker: default | lld | mold | gold | lld-link
#
# Usage: include("${LINALG_SOURCE_DIR}/Cmake/lto.cmake") → linalg_lto_compute_default → cache *_LTO_MODE → add_library →
#        linalg_target_apply_lto → linalg_find_linker
#
# linalg_print_lto_linker_summary(<PREFIX>)
#   Prints LTO mode and linker choice (and auto→thin/ipo hint) for module summaries.
# =============================================================================
include_guard(GLOBAL)
include(CheckIPOSupported)
include(CheckCXXCompilerFlag)

function(_linalg_msvc_link out)
    set(_v FALSE)
    if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
            set(_v TRUE)
        elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
                set(_v TRUE)
            elseif(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "" AND CMAKE_CXX_COMPILER MATCHES
                                                                       "clang-cl"
            )
                set(_v TRUE)
            endif()
        endif()
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
endfunction()

# First matching linker from candidate executable names.
function(_linalg_first_linker out)
    foreach(_n IN LISTS ARGN)
        find_program(_p NAMES "${_n}")
        if(_p)
            set(${out} "${_p}" PARENT_SCOPE)
            unset(_p CACHE)
            return()
        endif()
        unset(_p CACHE)
    endforeach()
    set(${out} "" PARENT_SCOPE)
endfunction()

function(linalg_print_lto_linker_summary prefix)
    set(_m "${${prefix}_LTO_MODE}")
    if(NOT DEFINED ${prefix}_LINKER_CHOICE)
        set(_link "default")
    else()
        set(_link "${${prefix}_LINKER_CHOICE}")
    endif()
    string(TOLOWER "${_m}" _low)
    set(_hint "")
    if(_low STREQUAL "auto")
        _linalg_msvc_link(_w)
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT _w)
            set(_hint " → thin")
        else()
            set(_hint " → ipo")
        endif()
    endif()
    set(_skip "")
    if(${prefix}_ENABLE_COVERAGE OR ${prefix}_ENABLE_SANITIZER)
        set(_skip " (skipped: coverage/sanitizer)")
    endif()
    message("  LTO mode             : ${_m}${_hint}${_skip}")
    message("  Linker choice        : ${_link}")
endfunction()

function(linalg_lto_compute_default out_var)
    cmake_parse_arguments(_ql "" "PROFILE" "" ${ARGN})
    if(NOT _ql_PROFILE)
        set(_ql_PROFILE "PERFORMANCE")
    endif()
    if(_ql_PROFILE STREQUAL "SUPPORT")
        set(${out_var} "off" PARENT_SCOPE)
        return()
    endif()
    if(NOT CMAKE_BUILD_TYPE)
        set(${out_var} "off" PARENT_SCOPE)
        return()
    endif()
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _bt)
    if(_bt STREQUAL "DEBUG")
        set(${out_var} "off" PARENT_SCOPE)
        return()
    endif()
    set(${out_var} "auto" PARENT_SCOPE)
endfunction()

function(linalg_target_apply_lto target prefix)
    set(_m "${${prefix}_LTO_MODE}")
    string(TOLOWER "${_m}" _m)
    if(NOT _m MATCHES "^(off|thin|full|ipo|auto)$")
        message(FATAL_ERROR "Invalid ${prefix}_LTO_MODE: ${_m}")
    endif()
    set_property(TARGET "${target}" PROPERTY LINALG_EFFECTIVE_LTO off)
    set_property(TARGET "${target}" PROPERTY INTERPROCEDURAL_OPTIMIZATION OFF)
    if(_m STREQUAL "off")
        message(STATUS "${target}: LTO off")
        return()
    endif()
    if(${prefix}_ENABLE_COVERAGE OR ${prefix}_ENABLE_SANITIZER)
        message(STATUS "${target}: LTO skipped (coverage/sanitizer)")
        return()
    endif()
    get_target_property(_target_type "${target}" TYPE)
    set(_lto_link_scope PRIVATE)
    if(_target_type STREQUAL "STATIC_LIBRARY")
        set(_lto_link_scope PUBLIC)
    endif()
    get_target_property(_launch "${target}" CXX_COMPILER_LAUNCHER)
    get_target_property(_cache_backend "${target}" LINALG_CACHE_BACKEND)
    if(_cache_backend STREQUAL "sccache" OR _launch MATCHES "sccache")
        message(
            FATAL_ERROR
                "${target}: LTO incompatible with sccache — set ${prefix}_CACHE_BACKEND=none or LTO off"
        )
    endif()

    if(${prefix}_ENABLE_CUBLAS)
        message(FATAL_ERROR "LTO with CUDA is not supported; set ${prefix}_LTO_MODE=off")
    endif()
    _linalg_msvc_link(_msvc)
    if(_m STREQUAL "auto")
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT _msvc)
            set(_m "thin")
        else()
            set(_m "ipo")
        endif()
    endif()

    if(_m STREQUAL "thin")
        # -flto=thin emits bitcode; default try_compile links with bfd and fails — use static lib probe.
        set(_save_try "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
        set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
        check_cxx_compiler_flag("-flto=thin" LINALG_THIN_LTO_SUPPORTED)
        set(_ok ${LINALG_THIN_LTO_SUPPORTED})
        set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_save_try}")
        set(_flag "-flto=thin")
        if(NOT _ok AND _msvc)
            set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
            check_cxx_compiler_flag("/clang:-flto=thin" LINALG_CLANG_CL_THIN_LTO_SUPPORTED)
            set(_ok2 ${LINALG_CLANG_CL_THIN_LTO_SUPPORTED})
            set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_save_try}")
            if(_ok2)
                set(_flag "/clang:-flto=thin")
                set(_ok TRUE)
            endif()
        endif()
        if(_ok)
            target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${_flag}>")
            target_link_options("${target}" ${_lto_link_scope} "${_flag}")
            set_property(TARGET "${target}" PROPERTY LINALG_EFFECTIVE_LTO thin)
            message(STATUS "${target}: ThinLTO (${_flag})")
            return()
        endif()
        message(FATAL_ERROR "${target}: ThinLTO unsupported")
    endif()

    if(_m STREQUAL "full")
        if(MSVC AND NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
            target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:/GL>")
            target_link_options("${target}" ${_lto_link_scope} /LTCG)
            set_property(TARGET "${target}" PROPERTY LINALG_EFFECTIVE_LTO full)
            message(STATUS "${target}: LTO (/GL /LTCG)")
            return()
        endif()
        set(_save_try "${CMAKE_TRY_COMPILE_TARGET_TYPE}")
        set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
        check_cxx_compiler_flag("-flto" LINALG_FULL_LTO_SUPPORTED)
        set(CMAKE_TRY_COMPILE_TARGET_TYPE "${_save_try}")
        set(_fok ${LINALG_FULL_LTO_SUPPORTED})
        if(_fok)
            target_compile_options("${target}" PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-flto>")
            target_link_options("${target}" ${_lto_link_scope} -flto)
            set_property(TARGET "${target}" PROPERTY LINALG_EFFECTIVE_LTO full)
            message(STATUS "${target}: LTO (-flto)")
            return()
        endif()
        message(FATAL_ERROR "${target}: full LTO unsupported")
    endif()

    if(_m STREQUAL "ipo")
        check_ipo_supported(RESULT _iok OUTPUT _ierr LANGUAGES CXX)
        if(_iok)
            set_target_properties("${target}" PROPERTIES INTERPROCEDURAL_OPTIMIZATION ON)
            set_property(TARGET "${target}" PROPERTY LINALG_EFFECTIVE_LTO ipo)
            if(_target_type STREQUAL "STATIC_LIBRARY" AND MSVC AND NOT CMAKE_CXX_COMPILER_ID
                                                                   MATCHES "Clang"
            )
                target_link_options("${target}" INTERFACE /LTCG)
            elseif(_target_type STREQUAL "STATIC_LIBRARY")
                target_link_options("${target}" INTERFACE -flto)
            endif()
            message(STATUS "${target}: IPO/LTO")
        else()
            message(FATAL_ERROR "${target}: IPO unsupported: ${_ierr}")
        endif()
        return()
    endif()

    message(WARNING "${target}: unknown LTO mode '${${prefix}_LTO_MODE}'")
endfunction()

function(_linalg_apply_fuse target path)
    if(NOT path OR NOT TARGET "${target}")
        return()
    endif()
    _linalg_msvc_link(_msvc)
    if(_msvc)
        message(
            FATAL_ERROR
                "Explicit per-target linker selection requires a GNU compiler driver. "
                "For MSVC or clang-cl, select CMAKE_LINKER in a toolchain file and use LINALG_LINKER_CHOICE=default."
        )
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        get_filename_component(_b "${path}" NAME)
        string(REGEX REPLACE "\\.exe$" "" _s "${_b}")
        string(REPLACE "ld." "" _s "${_s}")
        if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
            # The absolute path of the multi-call `lld` driver is not a linker:
            # Clang executes it and it exits with "Invoke ld.lld instead".
            # `-fuse-ld=lld` makes Clang select ld.lld itself.
            if(_s STREQUAL "lld")
                target_link_options("${target}" PRIVATE "-fuse-ld=lld")
            else()
                target_link_options("${target}" PRIVATE "-fuse-ld=${path}")
            endif()
        else()
            get_filename_component(_link_dir "${path}" DIRECTORY)
            target_link_options("${target}" PRIVATE "-B${_link_dir}" "-fuse-ld=${_s}")
        endif()
        message(STATUS "Linker: ${target} → -fuse-ld=${_s}")
    endif()
endfunction()

# Resolve linker: lto_on picks LLVM-friendly order for Clang; otherwise speed-first order.
function(_linalg_pick_link linker_choice target lto_on)
    set(_path "")
    if(NOT linker_choice STREQUAL "default")
        if(linker_choice STREQUAL "lld")
            # Search the ELF frontend before the multi-call `lld` driver.
            find_program(_e NAMES "ld.lld" "lld" "lld-link")
        else()
            find_program(_e NAMES "${linker_choice}" "ld.${linker_choice}" "${linker_choice}-link")
        endif()
        if(_e)
            set(_path "${_e}")
            message(STATUS "Linker: explicit '${linker_choice}'")
        else()
            message(FATAL_ERROR "Requested linker ${linker_choice} not found")
        endif()
        unset(_e CACHE)
    endif()

    if(_path)
        _linalg_apply_fuse("${target}" "${_path}")
        return()
    endif()

    _linalg_msvc_link(_msvc)
    if(_msvc OR CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        return()
    endif()

    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        _linalg_first_linker(_path ld64.lld)
        if(_path)
            _linalg_apply_fuse("${target}" "${_path}")
        elseif(NOT lto_on)
            message(STATUS "Linker: macOS system ld64")
        else()
            message(STATUS "Linker: macOS ld64 (LTO-capable)")
        endif()
        return()
    endif()

    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
            if(lto_on)
                _linalg_first_linker(_path ld.lld mold ld.gold)
            else()
                _linalg_first_linker(_path mold ld.gold ld.lld)
            endif()
        elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            _linalg_first_linker(_path mold ld.gold ld.lld)
        endif()
        if(_path)
            _linalg_apply_fuse("${target}" "${_path}")
        elseif(lto_on)
            message(WARNING "Linker: install ld.lld, mold, or gold for LTO")
        else()
            message(STATUS "Linker: platform default")
        endif()
        return()
    endif()

    if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            _linalg_first_linker(_path ld.lld lld)
            if(_path)
                _linalg_apply_fuse("${target}" "${_path}")
            endif()
        endif()
    endif()
endfunction()

function(linalg_find_linker linker_choice target_name)
    if(NOT linker_choice MATCHES "^(default|lld|mold|gold|lld-link)$")
        message(FATAL_ERROR "Invalid linker choice: ${linker_choice}")
    endif()
    get_target_property(_effective "${target_name}" LINALG_EFFECTIVE_LTO)
    set(_lto FALSE)
    if(_effective AND NOT _effective STREQUAL "off")
        set(_lto TRUE)
    endif()
    _linalg_pick_link("${linker_choice}" "${target_name}" ${_lto})
endfunction()

# LTO mode to forward to bundled dependencies. Coverage and sanitizers skip
# LTO on LinearAlgebra; forwarding the requested mode would publish -flto from
# static archives into those links and would turn LTO back on next to sccache.
function(linalg_dependency_lto_mode out_var)
    set(_mode "${LINALG_LTO_MODE}")
    string(TOLOWER "${_mode}" _mode)
    if(LINALG_ENABLE_COVERAGE OR LINALG_ENABLE_SANITIZER OR _mode STREQUAL "")
        set(_mode "off")
    endif()
    set(${out_var} "${_mode}" PARENT_SCOPE)
endfunction()

# Scalars exports a shared MSVC library with WINDOWS_EXPORT_ALL_SYMBOLS.
# CMake's export dumper cannot parse the LTCG objects /GL and IPO produce.
function(linalg_scalars_lto_mode out_var)
    linalg_dependency_lto_mode(_mode)
    if(BUILD_SHARED_LIBS AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" AND NOT _mode STREQUAL "off")
        set(_mode "off")
    endif()
    set(${out_var} "${_mode}" PARENT_SCOPE)
endfunction()

# Scalars passes -fuse-ld=<absolute path>. find_program("lld") returns the
# multi-call driver, which cannot link. Its default search prefers ld.lld
# when LTO is enabled and another real linker otherwise.
function(linalg_scalars_linker_choice out_var)
    set(_choice "${LINALG_LINKER_CHOICE}")
    if(_choice STREQUAL "" OR _choice STREQUAL "lld")
        set(_choice "default")
    endif()
    set(${out_var} "${_choice}" PARENT_SCOPE)
endfunction()
