# Standalone LinearAlgebra library. Include root is the repository root; public headers live
# under include/ (e.g. #include "include/matrix_operation/lu_decomposition.h"), implementation
# files under the mirrored src/ tree (e.g.
# src/matrix_operation/native/lu_decomposition_native.cpp).
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//bazel:linear_algebra.bzl", "linear_algebra_copts", "linear_algebra_defines", "linear_algebra_linkopts")

package(default_visibility = ["//visibility:public"])

# LINALG_HAS_MKL / LINALG_HAS_BLAS / LINALG_HAS_LU_PIVOTING reach the
# compiler via linear_algebra_defines()'s select() below (//bazel:
# linalg_enable_mkl / linalg_enable_blas / linalg_lu_pivoting), always
# defined 0/1 (never conditionally-defined/#ifdef-style). The same
# linalg_enable_mkl / linalg_enable_blas settings also select() whether
# src/matrix_operation/mkl/*.cpp / src/matrix_operation/blas/*.cpp are part
# of linear_algebra_srcs; the #if LINALG_HAS_MKL / #if LINALG_HAS_BLAS guards
# inside those files remain as a second line of defense. Neither setting
# resolves mkl.h/cblas.h/lapacke.h or links an MKL/BLAS/LAPACK library the
# way CMakeLists.txt's find_package(MKL)/find_package(BLAS)/find_path() do,
# so a Bazel build with either set still depends on those headers/libs
# already being on the toolchain's default search paths. LINALG_HAS_CUBLAS
# (and its helper macros) has no Bazel toggle at all — CMake is this repo's
# primary, exercised build system for the mkl / blas_lapack backends and the
# cuBLAS/cuSOLVER GPU backend (src/matrix_operation/cublas/ +
# include/matrix_operation/multiplication_batched.h, not part of this glob).

filegroup(
    name = "linear_algebra_hdrs",
    srcs = glob(
        [
            "include/common/*.h",
            "include/memory/*.h",
            "include/util/*.h",
            "include/matrix_operation/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "linear_algebra_srcs",
    srcs = glob(
        [
            "src/common/*.cpp",
            "src/matrix_operation/*.cpp",
            "src/matrix_operation/native/*.cpp",
        ],
        allow_empty = True,
    ) + select({
        "//bazel:linalg_enable_mkl": glob(["src/matrix_operation/mkl/*.cpp"], allow_empty = True),
        "//conditions:default": [],
    }) + select({
        "//bazel:linalg_enable_blas": glob(["src/matrix_operation/blas/*.cpp"], allow_empty = True),
        "//conditions:default": [],
    }),
)

cc_library(
    name = "linear_algebra_lib",
    srcs = [":linear_algebra_srcs"],
    hdrs = [":linear_algebra_hdrs"],
    copts = linear_algebra_copts(),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    linkopts = linear_algebra_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    # Exception reporting (LOGGING_CHECK/LOGGING_THROW, see CLAUDE.md) is
    # implemented in ThirdParty/Logging, wired as its own Bazel module
    # (bazel_dep + local_path_override in MODULE.bazel, matching the sibling
    # Solvers project) rather than a plain subdirectory of this workspace.
    deps = ["@xsigma_logging//:Logging"],
    # Commit b09f66e replaced a PyTorch-style dispatch_stub function-pointer
    # registry (each backend self-registering via a static initializer, with
    # no other translation unit calling into it directly) with the current
    # #if LINALG_HAS_MKL / #elif LINALG_HAS_BLAS / #else chain compiled
    # directly into each op's public entry point — see
    # docs/gpu_backend_design.md §2. Every op's .cpp now defines a symbol
    # (e.g. linalg::multiplication) that callers reference directly,
    # so an ordinary static-archive link already pulls in the .o's it needs.
    # alwayslink=True is kept here defensively (its removal has not been
    # verified against every Bazel consumer) rather than because the old
    # whole-archive-link workaround still applies.
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "LinearAlgebra",
    deps = [":linear_algebra_lib"],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS ...)` /
# `install(DIRECTORY include/ DESTINATION include/LinearAlgebra ...)`).
# `bazel build //:linear_algebra_pkg_tar` produces a relocatable tarball;
# `bazel run //:install -- --destdir=/some/prefix` stages the same tree
# directly on disk.
# =============================================================================

pkg_files(
    name = "linear_algebra_installed_hdrs",
    srcs = glob(
        ["include/**/*.h", "include/**/*.hxx", "include/**/*.hpp"],
        allow_empty = True,
    ),
    prefix = "include/LinearAlgebra/include",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "linear_algebra_installed_libs",
    srcs = [":linear_algebra_lib"],
    prefix = "lib",
)

pkg_tar(
    name = "linear_algebra_pkg_tar",
    srcs = [
        ":linear_algebra_installed_hdrs",
        ":linear_algebra_installed_libs",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":linear_algebra_installed_hdrs",
        ":linear_algebra_installed_libs",
    ],
)
