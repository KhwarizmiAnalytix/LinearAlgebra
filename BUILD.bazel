# Standalone LinearAlgebra library. Include root is the repository root; public headers live
# under include/ (e.g. #include "include/matrix_operation/lu_decomposition.h").
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:linear_algebra.bzl", "linear_algebra_copts", "linear_algebra_defines", "linear_algebra_linkopts")

package(default_visibility = ["//visibility:public"])

# Bazel equivalent of CMake's configure_file() for include/common/configure.h.in.
# LINALG_ENABLE_MKL / LINALG_LU_PIVOTING are left undefined here: those macros
# already reach the compiler via linear_algebra_defines()'s select() below, so
# this file only needs to exist on the include path, not redefine them.
# LINALG_ENABLE_BLAS / LINALG_ENABLE_CUBLAS (and their helper macros) have no
# Bazel toggle yet — CMake is this repo's primary, exercised build system for
# the blas_lapack/cublas backends (see include/matrix_operation/*_blas.cxx,
# *_cublas.cxx); Bazel builds always compile the scalar backend plus mkl when
# linalg_enable_mkl is set, matching pre-existing Bazel coverage.
expand_template(
    name = "configure_h",
    out = "include/common/configure.h",
    substitutions = {
        "#cmakedefine LINALG_ENABLE_MKL": "/* #undef LINALG_ENABLE_MKL */",
        "#cmakedefine LINALG_ENABLE_BLAS": "/* #undef LINALG_ENABLE_BLAS */",
        "#cmakedefine LINALG_ENABLE_CUBLAS": "/* #undef LINALG_ENABLE_CUBLAS */",
        "#cmakedefine LINALG_BLAS_USE_ACCELERATE": "/* #undef LINALG_BLAS_USE_ACCELERATE */",
        "#cmakedefine LINALG_BLAS_HAS_LAPACKE": "/* #undef LINALG_BLAS_HAS_LAPACKE */",
        "#cmakedefine LINALG_LU_PIVOTING": "/* #undef LINALG_LU_PIVOTING */",
        "#cmakedefine LINALG_DISPLAY_WIN32_WARNINGS": "/* #undef LINALG_DISPLAY_WIN32_WARNINGS */",
    },
    template = "include/common/configure.h.in",
)

filegroup(
    name = "linear_algebra_hdrs",
    srcs = glob(
        [
            "include/common/*.h",
            "include/memory/*.h",
            "include/util/*.h",
            "include/matrix_operation/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "linear_algebra_srcs",
    srcs = glob(
        [
            "include/common/*.cxx",
            "include/matrix_operation/*.cxx",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "linear_algebra_lib",
    srcs = [":linear_algebra_srcs"],
    hdrs = [":linear_algebra_hdrs", ":configure_h"],
    copts = linear_algebra_copts(),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    linkopts = linear_algebra_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    # Each backend (scalar/mkl/blas/cublas) registers itself into a
    # dispatch_stub purely via a static initializer in its own .cxx (see
    # include/common/dispatch_stub.h) — no other translation unit calls into
    # it directly. In a static archive, a linker only pulls in .o's that
    # satisfy an otherwise-unresolved symbol, so e.g. matrix_multiplication_
    # scalar.o would be silently dropped and its registration would never
    # run, failing every op at runtime ("no CPU implementation registered").
    # alwayslink=True forces every object from this library into any binary
    # that depends on it, regardless of whether the linker thinks it's
    # referenced.
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "LinearAlgebra",
    deps = [":linear_algebra_lib"],
    visibility = ["//visibility:public"],
)
