# Standalone LinearAlgebra library. Include root is the repository root; public headers live
# under include/ (e.g. #include "include/matrix_operation/lu_decomposition.h").
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:linear_algebra.bzl", "linear_algebra_copts", "linear_algebra_defines", "linear_algebra_linkopts")

package(default_visibility = ["//visibility:public"])

# LINALG_ENABLE_MKL / LINALG_LU_PIVOTING reach the compiler via
# linear_algebra_defines()'s select() below. LINALG_ENABLE_BLAS /
# LINALG_ENABLE_CUBLAS (and their helper macros) have no Bazel toggle yet —
# CMake is this repo's primary, exercised build system for the blas_lapack
# backend (compiled directly into each op's .cxx under
# include/matrix_operation/, gated by #if LINALG_ENABLE_BLAS) and the cuBLAS/
# cuSOLVER GPU backend (include/matrix_operation_gpu/, not part of this
# glob); Bazel builds always compile the scalar backend plus mkl when
# linalg_enable_mkl is set, matching pre-existing Bazel coverage.

filegroup(
    name = "linear_algebra_hdrs",
    srcs = glob(
        [
            "include/common/*.h",
            "include/memory/*.h",
            "include/util/*.h",
            "include/matrix_operation/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "linear_algebra_srcs",
    srcs = glob(
        [
            "include/common/*.cxx",
            "include/matrix_operation/*.cxx",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "linear_algebra_lib",
    srcs = [":linear_algebra_srcs"],
    hdrs = [":linear_algebra_hdrs"],
    copts = linear_algebra_copts(),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    linkopts = linear_algebra_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    # Each backend (scalar/mkl/blas/cublas) registers itself into a
    # dispatch_stub purely via a static initializer in its own .cxx (see
    # include/common/dispatch_stub.h) — no other translation unit calls into
    # it directly. In a static archive, a linker only pulls in .o's that
    # satisfy an otherwise-unresolved symbol, so e.g. matrix_multiplication_
    # scalar.o would be silently dropped and its registration would never
    # run, failing every op at runtime ("no CPU implementation registered").
    # alwayslink=True forces every object from this library into any binary
    # that depends on it, regardless of whether the linker thinks it's
    # referenced.
    alwayslink = True,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "LinearAlgebra",
    deps = [":linear_algebra_lib"],
    visibility = ["//visibility:public"],
)
