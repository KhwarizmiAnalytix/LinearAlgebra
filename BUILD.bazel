# Standalone LinearAlgebra library. Include root is the repository root; public headers live
# under include/ (e.g. #include "include/matrix_operation/lu_decomposition.h"), implementation
# files under the mirrored src/ tree (e.g.
# src/matrix_operation/cpu/native/lu_decomposition_native.cpp).
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//bazel:hip.bzl", "hip_library")
load("//bazel:linear_algebra.bzl", "linear_algebra_arch_copts", "linear_algebra_copts", "linear_algebra_defines", "linear_algebra_gpu_copts", "linear_algebra_linkopts")

package(default_visibility = ["//visibility:public"])

# LINALG_HAS_MKL / LINALG_HAS_BLAS / LINALG_HAS_LU_PIVOTING reach the
# compiler via linear_algebra_defines()'s select() below (//bazel:
# linalg_enable_mkl / linalg_enable_blas / linalg_lu_pivoting), always
# defined 0/1 (never conditionally-defined/#ifdef-style). The same
# linalg_enable_mkl / linalg_enable_blas settings also select() whether
# src/matrix_operation/cpu/mkl/*.cpp / src/matrix_operation/cpu/blas/*.cpp are part
# of linear_algebra_srcs; the #if LINALG_HAS_MKL / #if LINALG_HAS_BLAS guards
# inside those files remain as a second line of defense. Neither setting
# resolves mkl.h/cblas.h/lapacke.h or links an MKL/BLAS/LAPACK library the
# way CMakeLists.txt's find_package(MKL)/find_package(BLAS)/find_path() do,
# so a Bazel build with either set still depends on those headers/libs
# already being on the toolchain's default search paths.
# Combined MKL/BLAS builds also need LINALG_BLAS_RUNTIME_PATH defined as a
# string naming an independent shared provider (and optionally
# LINALG_LAPACKE_RUNTIME_PATH for a separate LAPACKE provider), plus libdl on ELF.
# CMake configures these paths automatically.
#
# GPU bridge .cpp files use the host toolchain. Device kernels are compiled
# separately and supply SDK headers and libraries through their dependencies.
# HIP builds require the ROCm Clang C++ toolchain; see .bazelrc.

filegroup(
    name = "linear_algebra_hdrs",
    srcs = glob(
        [
            "include/common/*.h",
            "include/memory/*.h",
            "include/util/*.h",
            "include/matrix_operation/*.h",
            "src/common/*.h",
            "src/matrix_operation/*.h",
            "src/matrix_operation/cpu/blas/*.h",
        ],
        allow_empty = True,
    ) + select({
        # GPU backend headers — cublas/ and hipblas/ each have internal .h files
        # used only by their own bridge .cpp sources. Include them in the hdrs
        # filegroup so the cc_library sandbox sees them when compiling the srcs.
        "//bazel:linalg_gpu_cuda": glob(
            ["src/matrix_operation/gpu/cublas/*.h"],
            allow_empty = True,
        ),
        "//bazel:linalg_gpu_hip": glob(
            ["src/matrix_operation/gpu/hipblas/*.h"],
            allow_empty = True,
        ),
        "//conditions:default": [],
    }),
)

filegroup(
    name = "linear_algebra_srcs",
    srcs = glob(
        [
            "src/common/*.cpp",
            "src/matrix_operation/cpu/*.cpp",
            "src/matrix_operation/cpu/native/*.cpp",
        ],
        allow_empty = True,
    ) + select({
        "//bazel:linalg_enable_mkl": glob(
            ["src/matrix_operation/cpu/mkl/*.cpp"],
            allow_empty = True,
        ),
        "//conditions:default": [],
    }) + select({
        "//bazel:linalg_enable_blas": glob(
            ["src/matrix_operation/cpu/blas/*.cpp"],
            allow_empty = True,
        ),
        "//conditions:default": [],
    }) + select({
        "//bazel:linalg_gpu_cuda": glob(
            ["src/matrix_operation/gpu/cublas/*.cpp"],
            allow_empty = True,
        ),
        "//bazel:linalg_gpu_hip": glob(
            ["src/matrix_operation/gpu/hipblas/*.cpp"],
            allow_empty = True,
        ),
        "//conditions:default": [],
    }),
)

cc_library(
    name = "linear_algebra_lib",
    srcs = [":linear_algebra_srcs"],
    hdrs = [":linear_algebra_hdrs"],
    copts = linear_algebra_copts() + linear_algebra_arch_copts() + linear_algebra_gpu_copts(),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    linkopts = linear_algebra_linkopts(),
    linkstatic = select({
        "//bazel:shared_libs": False,
        "//conditions:default": True,
    }),
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    # Exception reporting (LOGGING_CHECK/LOGGING_THROW, see CLAUDE.md) is
    # implemented in ThirdParty/Logging, wired as its own Bazel module
    # (bazel_dep + local_path_override in MODULE.bazel, matching the sibling
    # Solvers project) rather than a plain subdirectory of this workspace.
    deps = [
        "@scalars",
        "@xsigma_logging//:Logging",
    ] + select({
        "//bazel:linalg_gpu_cuda": [":linear_algebra_cuda_kernels"],
        "//bazel:linalg_gpu_hip": [":linear_algebra_hip_kernels"],
        "//conditions:default": [],
    }),
    # Commit b09f66e replaced a PyTorch-style dispatch_stub function-pointer
    # registry (each backend self-registering via a static initializer, with
    # no other translation unit calling into it directly) with the current
    # #if LINALG_HAS_MKL / #elif LINALG_HAS_BLAS / #else chain compiled
    # directly into each op's public entry point — see
    # docs/gpu_backend_design.md §2. Every op's .cpp now defines a symbol
    # (e.g. linalg::multiplication) that callers reference directly,
    # so an ordinary static-archive link already pulls in the .o's it needs.
    # alwayslink=True is kept here defensively (its removal has not been
    # verified against every Bazel consumer) rather than because the old
    # whole-archive-link workaround still applies.
    alwayslink = True,
)

cc_library(
    name = "LinearAlgebra",
    visibility = ["//visibility:public"],
    deps = [":linear_algebra_lib"],
)

# Device libraries are incompatible when their backend is disabled, so
# wildcard CPU builds do not analyze or compile either GPU toolchain.
cuda_library(
    name = "linear_algebra_cuda_kernels",
    srcs = glob(["src/matrix_operation/gpu/cublas/*.cu"]),
    hdrs = [":linear_algebra_hdrs"],
    copts = ["-std=c++20"] + select({
        "@rules_cuda//cuda:compiler_is_nvcc": ["--expt-relaxed-constexpr"],
        "//conditions:default": [],
    }),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    host_copts = linear_algebra_arch_copts() + select({
        "@platforms//os:windows": ["/Zc:preprocessor"],
        "//conditions:default": ["-fPIC"],
    }),
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "//bazel:linalg_gpu_cuda": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@cuda//:cublas",
        "@cuda//:cusolver",
        "@scalars",
        "@xsigma_logging//:Logging",
    ],
)

hip_library(
    name = "linear_algebra_hip_kernels",
    srcs = glob(["src/matrix_operation/gpu/hipblas/*.hip"]),
    hdrs = [":linear_algebra_hdrs"],
    copts = linear_algebra_copts() + linear_algebra_arch_copts(),
    defines = linear_algebra_defines() + select({
        "//bazel:shared_libs": ["LINALG_SHARED_DEFINE"],
        "//conditions:default": ["LINALG_STATIC_DEFINE"],
    }),
    enabled = "//bazel:linalg_gpu_hip",
    local_defines = select({
        "//bazel:shared_libs": ["LINALG_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    deps = [
        "@local_config_hip//:hipblas",
        "@local_config_hip//:hipsolver",
        "@scalars",
        "@xsigma_logging//:Logging",
    ],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS ...)` /
# `install(DIRECTORY include/ DESTINATION include/LinearAlgebra ...)`).
# `bazel build //:linear_algebra_pkg_tar` produces a relocatable tarball;
# `bazel run //:install -- --destdir=/some/prefix` stages the same tree
# directly on disk.
# =============================================================================

pkg_files(
    name = "linear_algebra_installed_hdrs",
    srcs = glob(
        [
            "include/**/*.h",
            "include/**/*.hxx",
            "include/**/*.hpp",
        ],
        allow_empty = True,
    ),
    prefix = "include/LinearAlgebra/include",
    strip_prefix = strip_prefix.from_pkg("include"),
)

pkg_files(
    name = "linear_algebra_installed_libs",
    srcs = [
        ":linear_algebra_lib",
        "@scalars",
    ] + select({
        "//bazel:linalg_gpu_cuda": [":linear_algebra_cuda_kernels"],
        "//bazel:linalg_gpu_hip": [":linear_algebra_hip_kernels"],
        "//conditions:default": [],
    }),
    prefix = "lib",
)

pkg_files(
    name = "linear_algebra_notices",
    srcs = [
        "LICENSES/MPL-2.0.txt",
        "LICENSES/matrix_functions.NOTICE",
    ],
    prefix = "share/LinearAlgebra/licenses",
    strip_prefix = strip_prefix.from_pkg("LICENSES"),
)

pkg_tar(
    name = "linear_algebra_pkg_tar",
    srcs = [
        ":linear_algebra_installed_hdrs",
        ":linear_algebra_installed_libs",
        ":linear_algebra_notices",
        ":scalars_notice",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":linear_algebra_installed_hdrs",
        ":linear_algebra_installed_libs",
        ":linear_algebra_notices",
        ":scalars_notice",
    ],
)

pkg_files(
    name = "scalars_notice",
    srcs = ["ThirdParty/Scalars/LICENSE"],
    prefix = "share/LinearAlgebra/licenses/Scalars",
    strip_prefix = strip_prefix.from_pkg("ThirdParty/Scalars"),
)
