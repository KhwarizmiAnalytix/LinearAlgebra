module(
    name = "xsigma_linearalgebra",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "google_benchmark", version = "1.9.1")

# Logging library (vendored git submodule), wired as its own Bazel module
# rather than a plain subdirectory — matches the sibling Solvers project.
# Its default LOGURU backend's always-on deps (fmt, loguru) are resolved via
# Logging's own MODULE.bazel; magic_enum is overridden here too so it comes
# from the vendored copy instead of Bazel Central Registry (glog/gflags stay
# on BCR but are never fetched since nothing selects the glog backend).
bazel_dep(name = "xsigma_logging", version = "1.0.0")
bazel_dep(name = "magic_enum", version = "0.9.8")

local_path_override(
    module_name = "xsigma_logging",
    path = "ThirdParty/Logging",
)

local_path_override(
    module_name = "magic_enum",
    path = "ThirdParty/Logging/ThirdParty/magic_enum",
)

# Resolve vendor paths relative to this workspace. Logging's extension records
# absolute paths in the shared lockfile, which cannot be reused on CI runners.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "eigen",
    path = "ThirdParty/eigen",
    build_file = "//bazel:eigen.BUILD",
)

new_local_repository(
    name = "fmt",
    path = "ThirdParty/Logging/ThirdParty/fmt",
    build_file = "@xsigma_logging//ThirdParty:fmt.BUILD",
)
new_local_repository(
    name = "loguru",
    path = "ThirdParty/Logging/ThirdParty/loguru",
    build_file = "@xsigma_logging//ThirdParty:loguru.BUILD",
)
new_local_repository(
    name = "spdlog",
    path = "ThirdParty/Logging/ThirdParty/spdlog",
    build_file = "@xsigma_logging//ThirdParty:spdlog.BUILD",
)

logging_vendor_deps = use_extension("@xsigma_logging//bazel:vendor_deps.bzl", "vendor_deps")
override_repo(logging_vendor_deps, "fmt", "loguru", "spdlog")

new_local_repository(
    name = "scalars",
    path = "ThirdParty/Scalars",
    build_file = "//bazel:scalars.BUILD",
)
